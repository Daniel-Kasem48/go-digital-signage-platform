# App
APP_ENV=development
APP_PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=signage
DB_USER=signage
DB_PASSWORD=change-me

# Auth
JWT_SECRET=change-me-to-a-long-random-string
AUTH_CHALLENGE_SECRET=change-me
DEVICE_SECRET=change-me

# S3-compatible object storage (MinIO locally, AWS S3 in production)
AWS_REGION=us-east-1
AWS_BUCKET=signage-dev
AWS_ENDPOINT=http://127.0.0.1:9001
AWS_KEY_ID=minioadmin
AWS_SECRET_KEY=change-me-please

# NATS (realtime messaging + KV state)
NATS_URL=nats://localhost:4222
NATS_REQUIRED=false
NATS_CONNECT_TIMEOUT=5s

# Development only
ENABLE_WEBSOCKET_TEST_ROUTES=false
